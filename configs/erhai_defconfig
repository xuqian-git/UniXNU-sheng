# Kernel configuration of the erhai image (OnePlus Pad 2 Pro, SM8750), derived from sheng_defconfig.
# CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build. drivers/NativeUfs overrides the base
# driver with the SM8750 controller (sm8750-ufshc match, translating SMMU context, Hibern8 exit).

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_VERIFIED_ROOT_PROBE=y
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_SHENG_PMGR=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=y
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ZONE_PGZ_ALIGNMENT_PROBE=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
# Oryon implements PAN; without it every exception into EL1 sets PSTATE.PAN and copyin faults loop.
CONFIG_XNU_NATIVE_PAN=y
CONFIG_XNU_BOOT_PROGRESS=y
# CPU-rendered NativeLegacyDisplay on the UEFI GOP framebuffer; no Adreno 830 support yet. The sheng display bundle's
# references to the Adreno 740 driver resolve to scripts/build-erhai-adreno-stubs.py's zero stand-ins.
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=y
CONFIG_XNU_NATIVE_ADRENO=n

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
# The RAM Data seed (out/erhai/data-seed/seed.json volume_uuid); it must change with the seed.
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="5A6AECE7-BEA6-425E-A5EF-6D26CF1B81D4"
CONFIG_XNU_NATIVE_VIRTIO_BLOCK_ARCHIVE="{tree}/build/native-virtio-block-verified-bundle/libNativeVirtioBlock.a"
CONFIG_XNU_VERIFIED_ROOT_ARCHIVE="{tree}/build/verified-root-os-xnu-bundle/libVerifiedRootProbe.a"
# The adreno-SMMU context part of NativeAdreno (scripts/build-erhai-adreno-context.py) ahead of the stand-ins.
CONFIG_XNU_EXTRA_LD_ARCHIVES="{tree}/build/erhai-adreno-context/libErhaiAdrenoContext.a {tree}/build/native-adreno-accelerator/libNativeAdrenoAccelerator.late.a {tree}/build/erhai-adreno-stubs/libErhaiAdrenoStubs.a"
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
